<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.ecotwin.controller.ScenariosController"
           styleClass="page-bg">

    <ScrollPane fitToWidth="true"
                hbarPolicy="NEVER"
                styleClass="content-scroll">

        <VBox spacing="24">
            <padding>
                <Insets top="32" right="32" bottom="32" left="32"/>
            </padding>

            <Label text="Scenarios"
                   styleClass="page-title"/>

            <Label text="Explore how changes to your household resource use could look without changing your real data."
                   styleClass="muted-text"
                   wrapText="true"/>

            <VBox fx:id="noHouseholdSection"
                  spacing="12">

                <Label text="Join or create a household first to create a sustainability scenario."
                       styleClass="muted-text"
                       wrapText="true"/>

            </VBox>

            <Label fx:id="errorLabel"
                   styleClass="error-text"
                   wrapText="true"
                   visible="false"
                   managed="false"/>

            <VBox fx:id="scenarioSection"
                  spacing="20">

                <VBox styleClass="card"
                      spacing="14"
                      maxWidth="700">

                    <Label text="Temporary scenario"
                           styleClass="page-title"/>

                    <Label text="These values start from your current household data. Changes made here will not change your real resource records."
                           styleClass="muted-text"
                           wrapText="true"/>

                    <Label text="Energy"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #F2F5F3;"/>

                    <HBox spacing="16">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Electricity (kWh)"
                                   styleClass="field-label"/>
                            <TextField fx:id="energyKwhField"/>
                        </VBox>

                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Solar generation (kWh)"
                                   styleClass="field-label"/>
                            <TextField fx:id="solarGenerationKwhField"/>
                        </VBox>
                    </HBox>

                    <Label text="Water"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #F2F5F3;"/>

                    <Label text="Water use (litres)"
                           styleClass="field-label"/>
                    <TextField fx:id="waterLitresField"/>

                    <Label text="Waste"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #F2F5F3;"/>

                    <HBox spacing="16">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="General waste (kg)"
                                   styleClass="field-label"/>
                            <TextField fx:id="generalWasteKgField"/>
                        </VBox>

                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Recycled (kg)"
                                   styleClass="field-label"/>
                            <TextField fx:id="recycledWasteKgField"/>
                        </VBox>

                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Compost (kg)"
                                   styleClass="field-label"/>
                            <TextField fx:id="compostKgField"/>
                        </VBox>
                    </HBox>

                    <Label text="Transport"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #F2F5F3;"/>

                    <HBox spacing="16">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Public transport trips per week"
                                   styleClass="field-label"/>
                            <TextField fx:id="publicTransportTripsField"/>
                        </VBox>

                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Flights per year"
                                   styleClass="field-label"/>
                            <TextField fx:id="flightsPerYearField"/>
                        </VBox>
                    </HBox>

                    <Label fx:id="statusLabel"
                           styleClass="muted-text"
                           wrapText="true"
                           visible="false"
                           managed="false"/>

                    <HBox spacing="12">
                        <Button text="Apply Scenario Changes"
                                styleClass="btn-primary"
                                onAction="#handleApplyScenarioChanges"/>

                        <Button text="Reset to Current Data"
                                styleClass="btn-secondary"
                                onAction="#handleResetScenario"/>
                    </HBox>

                </VBox>

            </VBox>

        </VBox>

    </ScrollPane>

</StackPane>
