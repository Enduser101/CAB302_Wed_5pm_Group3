<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.ecotwin.controller.DashboardController"
           styleClass="page-bg">

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll">

        <VBox spacing="24">
            <padding>
                <Insets top="32" right="32" bottom="32" left="32"/>
            </padding>

            <Label text="Dashboard" styleClass="page-title"/>

            <Label text="Indicative scores only: a rough guide based on your latest readings, not a validated emissions model."
                   styleClass="muted-text" wrapText="true"/>

            <Label fx:id="noDataLabel" styleClass="muted-text" wrapText="true"/>

            <VBox fx:id="scoresSection" spacing="20" maxWidth="900">

                <HBox spacing="12">
                    <VBox styleClass="card" spacing="8" minWidth="260">
                        <Label text="Overall score" styleClass="section-title"/>
                        <Label fx:id="totalScoreLabel" styleClass="page-title"/>
                        <Label fx:id="totalGradeLabel" styleClass="value-text"/>

                        <!-- US-22: fbature fills this with the explanation of what the score means -->
                        <Label fx:id="scoreExplanationLabel" styleClass="muted-text" wrapText="true"/>
                    </VBox>

                    <!-- PLACEHOLDER ONLY: the "Score over time" box from the high-fidelity design.
                         No chart is built here and it isn't in any user story yet;
                         it only shows a "coming soon" message. -->
                    <VBox styleClass="card" spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="Score over time" styleClass="section-title"/>
                        <Label text="Coming soon: your overall score month by month."
                               styleClass="muted-text" wrapText="true"/>
                    </VBox>
                </HBox>

                <!-- US-21: one card per domain, built in DashboardController -->
                <HBox fx:id="domainCards" spacing="12"/>

                <HBox spacing="16">
                    <Button text="View Recommendations" styleClass="btn-primary" onAction="#openRecommendations"/>
                    <Button text="Run Scenario" styleClass="btn-secondary" onAction="#openScenarios"/>
                    <Button text="Update Resources" styleClass="btn-secondary" onAction="#openResources"/>
                </HBox>

            </VBox>
        </VBox>
    </ScrollPane>
</StackPane>