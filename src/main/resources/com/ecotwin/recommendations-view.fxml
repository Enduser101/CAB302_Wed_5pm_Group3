<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.ecotwin.controller.RecommendationsController"
           styleClass="page-bg">

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll">

        <VBox spacing="16">
            <padding>
                <Insets top="32" right="32" bottom="32" left="32"/>
            </padding>

            <HBox alignment="CENTER_LEFT">
                <Label text="Recommendations" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="householdLabel" styleClass="section-title"/>
            </HBox>

            <Label fx:id="introLabel" styleClass="muted-text" wrapText="true"/>


            <HBox fx:id="filterTabs" spacing="4" styleClass="filter-tabs"/>

            <!-- US-24: one card per recommendation, weakest domain first -->
            <VBox fx:id="recommendationList" spacing="12"/>
        </VBox>
    </ScrollPane>
</StackPane>