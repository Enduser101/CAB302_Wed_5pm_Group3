<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            prefHeight="400.0" prefWidth="600.0">

    <Label text="Register"
           layoutX="160"
           layoutY="40" />

    <Label text="Username"
           layoutX="100"
           layoutY="90" />

    <TextField fx:id="usernameField"
               layoutX="100"
               layoutY="115"
               prefWidth="300" />

    <Label text="Email"
           layoutX="100"
           layoutY="160" />

    <TextField fx:id="emailField"
               layoutX="100"
               layoutY="185"
               prefWidth="300" />

    <Label text="Password"
           layoutX="100"
           layoutY="230" />

    <PasswordField fx:id="passwordField"
                   layoutX="100"
                   layoutY="255"
                   prefWidth="300" />

    <Label text="Confirm Password"
           layoutX="100"
           layoutY="300" />

    <PasswordField fx:id="confirmPasswordField"
                   layoutX="100"
                   layoutY="325"
                   prefWidth="300" />
</AnchorPane>
